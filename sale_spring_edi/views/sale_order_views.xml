<odoo>
  <record id="view_order_form_edi_info" model="ir.ui.view">
    <field name="name">sale.order.form.edi.info</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">

      <!-- Header fields, right-hand column -->
      <xpath expr="//group[@name='order_details']" position="inside">
        <field name="edi_has_data" invisible="1"/>
        <field name="edi_has_ship_to" invisible="1"/>
        <field name="edi_order_number" invisible="not edi_order_number"/>
        <field name="edi_ship_open_date" invisible="not edi_ship_open_date"/>
        <field name="edi_ship_close_date" invisible="not edi_ship_close_date"/>
      </xpath>

      <!-- Shows only if the standard Delivery button cannot find the order's transfers -->
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_edi_transfers" type="object" class="oe_stat_button"
                icon="fa-truck" groups="stock.group_stock_user"
                invisible="edi_transfer_count == 0">
          <field name="edi_transfer_count" widget="statinfo" string="Transfers"/>
        </button>
      </xpath>

      <!-- New tab -->
      <xpath expr="//notebook" position="inside">
        <page string="Spring Systems EDI info" name="spring_edi_info" invisible="not edi_has_data">
          <group>
            <group>
              <field name="edi_mark_for_location" invisible="not edi_mark_for_location"/>
              <field name="edi_order_message" invisible="not edi_order_message"/>
            </group>
            <group>
              <field name="edi_order_id" invisible="not edi_order_id"/>
              <field name="edi_division" invisible="not edi_division"/>
              <field name="edi_department" invisible="not edi_department"/>
              <field name="edi_merchandise_type" invisible="not edi_merchandise_type"/>
              <field name="edi_currency_code" invisible="not edi_currency_code"/>
              <field name="edi_shipping_pay_method" invisible="not edi_shipping_pay_method"/>
            </group>
          </group>
          <group string="Ship-To (as received via EDI)" invisible="not edi_has_ship_to">
            <group>
              <field name="edi_ship_to_code" invisible="not edi_ship_to_code"/>
              <field name="edi_ship_to_name" invisible="not edi_ship_to_name"/>
              <field name="edi_ship_to_street" invisible="not edi_ship_to_street"/>
              <field name="edi_ship_to_street2" invisible="not edi_ship_to_street2"/>
            </group>
            <group>
              <field name="edi_ship_to_city" invisible="not edi_ship_to_city"/>
              <field name="edi_ship_to_state" invisible="not edi_ship_to_state"/>
              <field name="edi_ship_to_zip" invisible="not edi_ship_to_zip"/>
              <field name="edi_ship_to_country" invisible="not edi_ship_to_country"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>

  <!-- Make EDI orders searchable from the list view search bar -->
  <record id="view_sales_order_filter_edi_info" model="ir.ui.view">
    <field name="name">sale.order.search.edi.info</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_sales_order_filter"/>
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="edi_order_number"/>
        <field name="edi_order_id"/>
      </field>
    </field>
  </record>
</odoo>
