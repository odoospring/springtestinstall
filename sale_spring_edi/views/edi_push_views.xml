<odoo>
  <!-- Endpoint configuration -->
  <record id="edi_push_endpoint_tree" model="ir.ui.view">
    <field name="name">edi.push.endpoint.tree</field>
    <field name="model">edi.push.endpoint</field>
    <field name="arch" type="xml">
      <tree><field name="name"/><field name="document_type"/><field name="auth_type"/><field name="url"/><field name="company_id"/><field name="active"/></tree>
    </field>
  </record>
  <record id="edi_push_endpoint_form" model="ir.ui.view">
    <field name="name">edi.push.endpoint.form</field>
    <field name="model">edi.push.endpoint</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="document_type"/>
            <field name="url" placeholder="https://example.com/api/edi"/>
            <field name="auth_type"/>
            <field name="api_key" password="True" invisible="auth_type != 'bearer'"/>
            <field name="username" invisible="auth_type != 'basic'" required="auth_type == 'basic'"/>
            <field name="password" password="True" invisible="auth_type != 'basic'"/>
            <field name="timeout"/>
            <field name="excluded_keys" placeholder="e.g. ship_to, customer"/>
            <field name="label_url_base" invisible="document_type == 'invoice'"/>
            <field name="label_send_auth" invisible="document_type == 'invoice'"/>
            <field name="company_id"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="edi_push_endpoint_action" model="ir.actions.act_window">
    <field name="name">External Push Endpoints</field>
    <field name="res_model">edi.push.endpoint</field>
    <field name="view_mode">tree,form</field>
  </record>
  <menuitem id="edi_push_endpoint_menu" name="External Push Endpoints"
            parent="sale.menu_sale_config" action="edi_push_endpoint_action"
            groups="base.group_system" sequence="90"/>

  <!-- Smart button: delivery -->
  <record id="view_picking_form_edi_push" model="ir.ui.view">
    <field name="name">stock.picking.form.edi.push</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_push_to_external" type="object"
                class="oe_stat_button" icon="fa-cloud-upload"
                invisible="state != 'done'">
          <div class="o_stat_info">
            <span class="o_stat_text">Push to EDI</span>
            <span class="o_stat_value"><field name="edi_push_state"/></span>
          </div>
        </button>
        <field name="edi_label_keys" invisible="1"/>
        <button name="action_get_shipping_labels" type="object"
                class="oe_stat_button" icon="fa-print"
                invisible="not edi_label_keys">
          <div class="o_stat_info">
            <span class="o_stat_text">Shipping Label</span>
            <span class="o_stat_value"><field name="edi_label_count"/></span>
          </div>
        </button>
        <button name="action_reset_push_state" type="object" string="Reset push"
                class="oe_stat_button" icon="fa-undo" groups="base.group_system"
                invisible="edi_push_state in (False, 'not_sent')"/>
      </xpath>
    </field>
  </record>

  <!-- Smart button: customer invoice -->
  <record id="view_move_form_edi_push" model="ir.ui.view">
    <field name="name">account.move.form.edi.push</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_push_to_external" type="object"
                class="oe_stat_button" icon="fa-cloud-upload"
                invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted'">
          <div class="o_stat_info">
            <span class="o_stat_text">Push to EDI</span>
            <span class="o_stat_value"><field name="edi_push_state"/></span>
          </div>
        </button>
        <button name="action_reset_push_state" type="object" string="Reset push"
                class="oe_stat_button" icon="fa-undo" groups="base.group_system"
                invisible="edi_push_state in (False, 'not_sent')"/>
      </xpath>
    </field>
  </record>
</odoo>
